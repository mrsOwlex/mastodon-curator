{
  "name": "mastodon-curator",
  "version": "1.0.0",
  "description": "Standalone Mastodon curator CLI: rules + LLM ranking of public timeline posts.",
  "type": "module",
  "license": "MIT",
  "author": "mrsOwlex",
  "homepage": "https://github.com/mrsOwlex/mastodon-curator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrsOwlex/mastodon-curator.git"
  },
  "bugs": {
    "url": "https://github.com/mrsOwlex/mastodon-curator/issues"
  },
  "keywords": [
    "mastodon",
    "fediverse",
    "curation",
    "openrouter",
    "llm",
    "cli"
  ],
  "files": [
    "dist",
    "interests.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "mastodon-curator": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^0.7.5",
    "ai": "~4.3.19",
    "cheerio": "^1.2.0",
    "dotenv": "^16.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
